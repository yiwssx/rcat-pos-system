{
  "name": "customer",
  "root": "apps/customer",
  "sourceRoot": "apps/customer/src",
  "projectType": "application",
  "targets": {
    "build": {
      "command": "pnpm exec ng build customer",
      "outputs": [
        "{workspaceRoot}/dist/apps/customer"
      ]
    },
    "serve": {
      "command": "pnpm exec ng serve customer --host 127.0.0.1",
      "continuous": true,
      "cache": false
    },
    "typecheck": {
      "command": "pnpm exec tsc --noEmit -p apps/customer/tsconfig.app.json"
    },
    "test": {
      "command": "pnpm exec vitest run apps/customer/src/app/app.spec.ts apps/customer/src/app/portal-access.spec.ts"
    },
    "lint": {
      "command": "pnpm exec prettier --write apps/customer/src/app/guest-order.api.ts apps/customer/src/app/guest-order.page.ts && git --no-pager diff -- apps/customer/src/app/guest-order.api.ts apps/customer/src/app/guest-order.page.ts && exit 1"
    }
  },
  "implicitDependencies": [
    "merchant",
    "admin"
  ]
}
