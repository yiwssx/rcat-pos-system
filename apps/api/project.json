{
  "name": "api",
  "root": "apps/api",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "targets": {
    "build": {
      "command": "pnpm exec tsc -p apps/api/tsconfig.app.json",
      "outputs": [
        "{workspaceRoot}/dist/apps/api",
        "{workspaceRoot}/dist/libs/server-auth"
      ]
    },
    "serve": {
      "command": "pnpm exec tsx watch apps/api/src/main.ts",
      "continuous": true,
      "cache": false
    },
    "typecheck": {
      "command": "pnpm exec tsc -p apps/api/tsconfig.app.json --noEmit"
    },
    "test": {
      "command": "pnpm exec vitest run apps/api/src/health/health-status.spec.ts apps/api/src/auth/email-delivery.service.spec.ts apps/api/src/orders/merchant-notification-stream.spec.ts apps/api/src/orders/operational-report.core.spec.ts"
    },
    "lint": {
      "command": "pnpm exec prettier --check 'apps/api/src/**/*.ts'"
    },
    "smoke": {
      "command": "node scripts/smoke-api.mjs",
      "dependsOn": [
        "build"
      ],
      "cache": false
    }
  }
}
