{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "apps",
  "projects": {
    "customer": {
      "projectType": "application",
      "root": "apps/customer",
      "sourceRoot": "apps/customer/src",
      "prefix": "rcat-customer",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/apps/customer",
            "index": "apps/customer/src/index.html",
            "browser": "apps/customer/src/main.ts",
            "tsConfig": "apps/customer/tsconfig.app.json",
            "styles": [
              "apps/customer/src/styles.css",
              "apps/customer/src/pos-v6-workspace.css"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/customer/public",
                "output": "/"
              }
            ]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "sourceMap": false,
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "apps/customer/proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "customer:build:production"
            },
            "development": {
              "buildTarget": "customer:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "merchant": {
      "projectType": "application",
      "root": "apps/merchant",
      "sourceRoot": "apps/merchant/src",
      "prefix": "rcat-merchant",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/apps/merchant",
            "index": "apps/merchant/src/index.html",
            "browser": "apps/merchant/src/main.ts",
            "tsConfig": "apps/merchant/tsconfig.app.json",
            "styles": ["apps/merchant/src/styles.css"],
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/merchant/public",
                "output": "/"
              }
            ]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "sourceMap": false,
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "apps/merchant/proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "merchant:build:production"
            },
            "development": {
              "buildTarget": "merchant:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "admin": {
      "projectType": "application",
      "root": "apps/admin",
      "sourceRoot": "apps/admin/src",
      "prefix": "rcat-admin",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/apps/admin",
            "index": "apps/admin/src/index.html",
            "browser": "apps/admin/src/main.ts",
            "tsConfig": "apps/admin/tsconfig.app.json",
            "styles": ["apps/admin/src/styles.css"]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "sourceMap": false,
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "apps/admin/proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "admin:build:production"
            },
            "development": {
              "buildTarget": "admin:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
