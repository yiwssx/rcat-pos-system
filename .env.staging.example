# Illustration only. Copy to a protected, chmod 600 .env.staging.
# Set actual staging-only values through the RCAT operator; do not commit them.
RCAT_POS_ENVIRONMENT=staging
RCAT_POS_RELEASE=staging-build-001
# Use 127.0.0.1 until RMS connectivity / firewall rules are reviewed.
RCAT_POS_HOST_BIND_IP=127.0.0.1
RCAT_POS_CUSTOMER_PORT=11880
RCAT_POS_MERCHANT_PORT=11881
RCAT_POS_ADMIN_PORT=11882
# Absolute path; file must be chmod 600 and be excluded from Git.
RCAT_POS_DB_PASSWORD_FILE=/opt/rcat-pos-system/.secrets/staging-pg-password

# Separate restricted PostgreSQL runtime logins; NEVER use the DBA for either.
# Quote passwords containing shell punctuation when filling values.
AUTH_DATABASE_URL='postgresql://AUTH_LOGIN:REPLACE@postgres:5432/rcat_pos_staging'
TENANT_DATABASE_URL='postgresql://TENANT_LOGIN:REPLACE@postgres:5432/rcat_pos_staging'

# Every browser origin and callback requires separately verified HTTPS/DNS.
AUTH_ALLOWED_ORIGINS=https://merchant-staging.example.invalid
CORS_ORIGINS=https://customer-staging.example.invalid,https://merchant-staging.example.invalid,https://admin-staging.example.invalid
GOOGLE_OAUTH_CLIENT_ID=REPLACE
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE
GOOGLE_OAUTH_REDIRECT_URI=https://merchant-staging.example.invalid/api/auth/google/callback
GUEST_TABLE_CODE_PEPPER=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
GUEST_ORDER_BASE_URL=https://customer-staging.example.invalid/order

# Set only exact trusted Docker/RMS ingress CIDRs after validating both hops.
# Socket peer only is safer than over-trusting spoofed proxy headers.
GUEST_TRUSTED_PROXY_CIDRS=

# Email is optional until delivery can be verified by the operator in staging.
MAIL_PROVIDER=
MAIL_FROM_EMAIL=
RESEND_API_KEY=
EMAIL_ACTION_BASE_URL=
