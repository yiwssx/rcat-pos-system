# This file contains no live secrets.
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202
# DATABASE_URL is added with PostgreSQL issue #3.
# No payment credentials until issue #7 (G5).

# Development-only authenticated API, not enabled by default.
ENABLE_DEVELOPMENT_AUTH=false
AUTH_ALLOWED_ORIGINS=http://localhost:4201
# AUTH_DATABASE_URL / TENANT_DATABASE_URL must be separate limited DB accounts.

# Outbound email is NOT enabled by default, and public auth is still disabled.
# Future security-reviewed setup:
# MAIL_PROVIDER=resend
# RESEND_API_KEY=             # secret vault only
# MAIL_FROM_EMAIL=no-reply@verified-domain.example
# EMAIL_ACTION_BASE_URL=https://pos.example.com/account
# Test-only flags for isolated CI, never on a public deployment:
ENABLE_REGISTRATION_TEST_MODE=false
ENABLE_RECOVERY_TEST_MODE=false
