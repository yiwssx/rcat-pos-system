# This file contains no live secrets.
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202
# DATABASE_URL is added with PostgreSQL issue #3.
# No payment credentials until issue #7 (G5).

# Development-only authenticated API, not enabled by default.
ENABLE_DEVELOPMENT_AUTH=false
AUTH_ALLOWED_ORIGINS=http://localhost:4201
# AUTH_DATABASE_URL / TENANT_DATABASE_URL must be separate limited DB accounts.
