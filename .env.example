# This file contains no live secrets.
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202
# DATABASE_URL is added with PostgreSQL issue #3.
# No payment credentials until issue #7 (G5).

# Development-only authenticated API, not enabled by default.
ENABLE_DEVELOPMENT_AUTH=false
AUTH_ALLOWED_ORIGINS=http://localhost:4201
# AUTH_DATABASE_URL / TENANT_DATABASE_URL must be separate limited DB accounts.

# Required to issue/redeem rotating 8-digit TABLE ordering codes.
# Generate independently on every environment: openssl rand -hex 32
# Never commit real values or reuse CI's dummy key.
# The same 32-byte pepper must be configured on every API replica.
GUEST_TABLE_CODE_PEPPER=
# HTTPS Customer /order base URL (must have no query or fragment).
GUEST_ORDER_BASE_URL=
# Product media uses restricted PostgreSQL bytea (max 192 KiB per image),
# not external object storage in G2. Backups must include this database.
